<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cesur.dam.inventarioappg1.controllers.MainController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="47.0" prefWidth="233.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15.0" /></padding>
            <Label text="Listado de equipos"><font><Font name="System Bold" size="22.0" /></font></Label>
            <Button alignment="TOP_RIGHT" contentDisplay="RIGHT" onAction="#onNuevo" style="-fx-background-color: #1976D2;" text="Nuevo" textFill="WHITE" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="cId" text="Nombre" />
                <TableColumn fx:id="cName" text="Descripcion" />
                <TableColumn fx:id="cCategory" text="Fecha" />
                <TableColumn fx:id="cAvailability" text="Estado" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
            <padding><Insets top="15.0" /></padding>
            <Button onAction="#onCerrarSesion" text="Cerrar sesión" />
        </HBox>
    </bottom>
</BorderPane>
